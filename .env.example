# Bazaar Configuration
BAZAAR_LEAD_EMAILS=lead1@example.com,lead2@example.com
BAZAAR_MAX_ACTIVE_REQUESTS=99999
BAZAAR_MAX_LOAN_DAYS=365

# Supabase (REST API — used by app code via supabase-js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (direct Postgres — used by db.js / scripts)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Auth & Security
JWT_SECRET=your-jwt-secret
CRON_SECRET=your-cron-secret
RECRUIT_JWT_SECRET=your-independent-recruit-secret
QR_SECRET=your-qr-signing-secret
PASSWORD_ENC_KEY=your-password-encryption-secret
# JSON username-to-password map for development staff accounts only
LEAD_ACCOUNTS={}

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
# Gmail app password used for attendance reminder BCC mail (10pm IST cron)
SMTP_PASSWORD_GOOGLE=
SMTP_EMAIL=your-email@example.com
ORGANIZER_EMAIL=your-organizer-email@example.com

# Web Push / Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-contact@example.com

# RFID attendance scanner (must match DEVICE_SECRET in attendance/secrets.h)
ATTENDANCE_DEVICE_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations; configure only for the feature being developed
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
ACADEMIA_API_URL=
ACADEMIA_BOT_USERNAME=
ACADEMIA_BOT_PASSWORD=
RAG_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
VOYAGE_API_KEY=
GROQ1=
GROQ2=
GROQ_MODEL=
