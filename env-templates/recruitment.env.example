# Shareable checklist for recruitment API setup. Fill with credentials issued for that developer/environment.
# Do not put production service-role keys or personal API secrets in this template.

# Supabase (server-side only; use a project/database with only the access needed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin and recruitment sessions
JWT_SECRET=
RECRUIT_JWT_SECRET=
QR_SECRET=
PASSWORD_ENC_KEY=
LEAD_ACCOUNTS=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail
RECRUIT_OTP_FROM_EMAIL=
ORGANIZER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_EMAIL=
SMTP_PASSWORD_GOOGLE=

# Optional recruitment knowledge base / AI
RAG_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ1=
GROQ2=
GROQ_MODEL=
VOYAGE_API_KEY=
